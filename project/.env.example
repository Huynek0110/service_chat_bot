PORT=3000
NODE_ENV=development

# --- AI local (LM Studio) ---
LMSTUDIO_BASE_URL=http://localhost:1234/v1
LMSTUDIO_API_KEY=lm-studio
LMSTUDIO_CHAT_MODEL=google/gemma-3-1b
# Embedding model id served by LM Studio at /v1/embeddings.
# LEAVE EMPTY to disable RAG gracefully (chat still works, no knowledge-base context).
# Example when you load an embedding model in LM Studio:
# LMSTUDIO_EMBEDDING_MODEL=text-embedding-nomic-embed-text-v1.5
LMSTUDIO_EMBEDDING_MODEL=
# Vector width for kb_vectors. Must match the embedding model you actually load.
EMBEDDING_DIM=768
LMSTUDIO_TEMPERATURE=0.3
LMSTUDIO_MAX_TOKENS=2048
LMSTUDIO_TIMEOUT_MS=180000
# "Thinking"/reasoning hint. The local OpenAI-compatible API has no `think`
# flag; this maps to a reasoning hint in the request and is off by default.
LMSTUDIO_THINK=false

ACTIVE_SYSTEM_PROMPT=default.md

ENABLE_WEB_SEARCH=false
WEB_SEARCH_PROVIDER=tavily
WEB_SEARCH_API_KEY=your_tavily_key

# --- Facebook Messenger (bo qua neu chi dung Telegram) ---
# Chi can dien 4 dong nay khi MESSENGER_ENABLED=true
MESSENGER_ENABLED=false
MESSENGER_VERIFY_TOKEN=your_token
MESSENGER_APP_SECRET=your_app_secret
MESSENGER_PAGE_ACCESS_TOKEN=your_page_access_token
MESSENGER_PAGE_ID=your_page_id

TELEGRAM_ENABLED=true
TELEGRAM_BOT_TOKEN=your_bot_token

ADMIN_USERNAME=admin
ADMIN_PASSWORD=doi-mat-khau-nay

BOT_DISCLOSURE_MESSAGE=Đây là trợ lý ảo tự động của shop, mình sẽ hỗ trợ bạn nhé!
FALLBACK_ERROR_MESSAGE=Xin lỗi, hệ thống đang gặp sự cố, bạn vui lòng thử lại sau ít phút nhé.

MAX_HISTORY_MESSAGES=12
RAG_TOP_K=4

RATE_LIMIT_WINDOW_MS=10000
RATE_LIMIT_MAX_MESSAGES=10

# --- Admin session (login page) ---
# Secret used to sign the admin_session cookie (HMAC-SHA256).
# LEAVE EMPTY to let the app generate one on first boot and keep it in
# data/session-secret.key, so sessions survive a restart either way.
# Set your own long random string to pin it. Changing it signs everyone out.
SESSION_SECRET=