<script>
  (function () {
    var root = document.documentElement;
    var links = document.querySelectorAll('.nav-link');
    var path = location.pathname.replace(/\/+$/, '') || '/';
    var i, link, href;

    // The server passes no "active page" local, so derive it from the URL.
    for (i = 0; i < links.length; i++) {
      link = links[i];
      href = (link.getAttribute('href') || '').replace(/\/+$/, '') || '/';
      if (href === path || (href !== '/admin' && path.indexOf(href + '/') === 0)) {
        link.className += ' active';
        link.setAttribute('aria-current', 'page');
      }
    }

    var toggle = document.getElementById('navToggle');
    function setMenu(open) {
      if (open) { document.body.classList.add('nav-open'); } else { document.body.classList.remove('nav-open'); }
      toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
    }
    toggle.addEventListener('click', function () {
      setMenu(document.body.classList.indexOf('nav-open') === -1);
    });
    document.getElementById('navScrim').addEventListener('click', function () { setMenu(false); });
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' || e.keyCode === 27) { setMenu(false); }
    });

    var themeBtn = document.getElementById('themeToggle');
    var themeLabel = document.getElementById('themeLabel');
    function syncTheme() {
      var dark = root.getAttribute('data-theme') === 'dark';
      themeBtn.setAttribute('aria-pressed', dark ? 'true' : 'false');
      themeLabel.textContent = dark ? 'Chế độ sáng' : 'Chế độ tối';
    }
    syncTheme();
    themeBtn.addEventListener('click', function () {
      var next = root.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
      root.setAttribute('data-theme', next);
      try { window.localStorage.setItem('admin-theme', next); } catch (e) { /* private mode: theme is not persisted */ }
      syncTheme();
    });
  })();
</script>
