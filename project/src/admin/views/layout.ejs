  .badge-green { background: var(--green-bg); color: var(--green-text); }
  .badge-yellow { background: var(--yellow-bg); color: var(--yellow-text); }
  .badge-red { background: var(--red-bg); color: var(--red-text); }
  .badge-gray { background: var(--gray-bg); color: var(--gray-text); }

  .alert-error, .error {
    color: var(--err-text);
    background: var(--err-bg);
    border: 1px solid var(--err-border);
    border-left: 3px solid var(--danger);
    border-radius: var(--radius);
    padding: 11px 14px;
    margin: 10px 0;
  }
  .alert-ok, .ok {
    color: var(--ok-text);
    background: var(--ok-bg);
    border: 1px solid var(--ok-border);
    border-left: 3px solid var(--ok-accent);
    border-radius: var(--radius);
    padding: 11px 14px;
    margin: 10px 0;
  }
  .alert-warn, .warn {
    color: var(--warn-text);
    background: var(--warn-bg);
    border: 1px solid var(--warn-border);
    border-left: 3px solid var(--warn-accent);
    border-radius: var(--radius);
    padding: 11px 14px;
    margin: 10px 0;
  }
  .alert-error ul, .alert-ok ul, .alert-warn ul,
  .error ul, .ok ul, .warn ul { margin: 6px 0 0; padding-left: 20px; }

  /* Filter / delete forms are marked style="display:inline" by several views. */
  form[style*="display:inline"] { margin: 0; }

  .form-group { margin: 14px 0; }
  .form-group label { display: block; margin: 0 0 6px; font-weight: 600; font-size: 14px; color: var(--text-soft); }
  label { display: block; margin: 12px 0 3px; font-weight: 600; font-size: 14px; color: var(--text-soft); }
  .form-control {
    width: 100%;
    max-width: 560px;
    padding: 9px 12px;
    font: 400 14px/1.5 var(--font-sans);
    box-sizing: border-box;
    border: 1px solid var(--control-border);
    border-radius: var(--radius);
    background: var(--surface);
    color: var(--text);
    font-family: inherit;
    transition: border-color var(--transition-fast), box-shadow var(--transition-fast), background-color var(--transition-fast);
  }
  .form-control:hover { border-color: var(--text-soft); }
  .form-control:focus-visible {
    outline: none;
    border-color: var(--primary);
    box-shadow: var(--ring-shadow);
  }
  .form-control-tall { min-height: 300px; }
  :where(input[type=text], input[type=number], input[type=password], input[type=email],
         input[type=url], input[type=tel], input[type=search], input[type=date],
         input[type=file], textarea, select) {
    width: 100%;
    max-width: 560px;
    padding: 9px 12px;
    font: 400 14px/1.5 var(--font-sans);
    color: var(--text);
    border: 1px solid var(--control-border);
    border-radius: var(--radius);
    background: var(--surface);
    box-sizing: border-box;
  }
  :where(input[type=text], input[type=number], input[type=password], input[type=email],
         input[type=url], input[type=tel], input[type=search], input[type=date],
         input[type=file], textarea, select):hover { border-color: var(--text-soft); }
  :where(textarea) { min-height: 90px; resize: vertical; }
  /* Original rule kept: CSV boxes are tall and must stay monospace. */
  textarea.csv { min-height: 220px; font-family: var(--font-mono); font-size: 13px; }
  :where(button) {
    margin: 6px 6px 6px 0;
    padding: 6px 12px;
    cursor: pointer;
    font-family: inherit;
  }
  :where(button):disabled { opacity: 0.55; cursor: not-allowed; }

  .muted { color: var(--muted); font-size: 13px; }
  code {
    background: var(--surface-inset);
    border: 1px solid var(--border);
    color: var(--text);
    padding: 2px 6px;
    border-radius: var(--radius-sm);
    font: 400 12.5px/1.5 var(--font-mono);
    word-break: break-word;
  }
  /* orders_list.ejs paints one <code> block with an inline white background so the
     delivered acc lines stay copy-paste friendly. That inline background is not
     themeable, so pin the ink to stay readable against it. */
  code[style] { color: var(--ink-on-light); }

  .section-title {
    display: flex;
    align-items: center;
    gap: 12px;
    margin: 28px 0 12px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    /* --muted, not --text-faint: this label is real text, so it needs 4.5:1. */
    color: var(--muted);
  }
  .section-title::after { content: ''; flex: 1; height: 1px; background: var(--border); }

  .empty-state {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    padding: 44px 20px;
    text-align: center;
    color: var(--muted);
    background: var(--surface);
    border: 1px dashed var(--border-strong);
    border-radius: var(--radius-lg);
  }
  .empty-state .empty-title { font-weight: 600; color: var(--text-soft); }

  /* Stat tiles used by the dashboard. */
  .stat { position: relative; overflow: hidden; display: flex; flex-direction: column; gap: 4px; }
  .stat::before { content: ''; position: absolute; top: 0; left: 0; right: 0; height: 3px; background: var(--brand-grad); }
  .stat.is-green::before { background: var(--grad-green); }
  .stat.is-amber::before { background: var(--grad-amber); }
  .stat.is-rose::before { background: var(--grad-rose); }
  .stat.is-slate::before { background: var(--grad-slate); }
  .stat-top { display: flex; align-items: center; gap: 10px; margin-bottom: 4px; }
  .stat-icon {
    flex: 0 0 auto;
    width: 38px;
    height: 38px;
    border-radius: var(--radius-md);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: var(--primary-soft);
    color: var(--primary-text);
  }
  .stat-icon svg { width: 20px; height: 20px; }
  .stat-icon.is-green { background: var(--green-bg); color: var(--green-text); }
  .stat-icon.is-amber { background: var(--yellow-bg); color: var(--yellow-text); }
  .stat-icon.is-rose { background: var(--red-bg); color: var(--red-text); }
  .stat-icon.is-slate { background: var(--gray-bg); color: var(--gray-text); }
  .stat-label { font-size: 13px; font-weight: 600; letter-spacing: 0.01em; color: var(--muted); }
  .stat-num {
    font-size: 30px;
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.025em;
    color: var(--text-strong);
    font-variant-numeric: tabular-nums;
  }
  .stat-foot { margin-top: 10px; }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }

  /* ========================================================== responsive === */
  /* Below 900px the sidebar becomes a top bar with a hamburger + dropdown panel. */
  @media (max-width: 900px) {
    body { padding-left: 0; padding-top: var(--topbar-h); }
    body.nav-open { overflow: hidden; }
    nav { right: 0; bottom: auto; width: auto; height: auto; }
    /* min-height so the fixed bar is exactly --topbar-h tall and lines up with the
       body padding. */
    .nav-top { min-height: var(--topbar-h); padding: 10px 14px; }
    .nav-toggle { display: inline-flex; align-items: center; }
    .nav-panel {
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      max-height: calc(100vh - var(--topbar-h));
      transform: translateY(-8px);
      opacity: 0;
      visibility: hidden;
      transition: transform var(--transition), opacity var(--transition), visibility var(--transition);
    }
    body.nav-open .nav-panel { transform: none; opacity: 1; visibility: visible; }
    body.nav-open .nav-scrim { opacity: 1; visibility: visible; }
    main { padding: 20px 16px 40px; }
  }
  @media (max-width: 640px) {
    main { padding: 16px 12px 32px; }
    h1 { font-size: 21px; }
    h2 { font-size: 16px; margin: 22px 0 10px; }
    .grid { grid-template-columns: 1fr; }
    .card { padding: 16px; }
    .card .num, .stat-num { font-size: 25px; }
    .table th, .table td { padding: 9px 10px; }
    .btn { padding: 7px 12px; }
  }
  @media (max-width: 380px) {
    .form-control,
    :where(input[type=text], input[type=number], input[type=password], input[type=email],
           input[type=url], input[type=tel], input[type=search], input[type=date],
           input[type=file], textarea, select) { max-width: 100%; }
  }

  /* Respect the OS "reduce motion" setting everywhere. */
  @media (prefers-reduced-motion: reduce) {
    *, *::before, *::after {
      animation-duration: 0.001ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.001ms !important;
      scroll-behavior: auto !important;
    }
    .card-hover:hover, .btn:active { transform: none; }
  }

  /* Printing the admin should not emit a dark sidebar on paper. */
  @media print {
    body { padding-left: 0; background: #ffffff; }
    nav, .nav-scrim { display: none !important; }
    main { max-width: none; padding: 0; }
    .table-wrap, .card { box-shadow: none; }
  }
</style>
<script>
  // Resolve the theme as the first thing in <body> so the admin never paints light
  // and then flips to dark. Explicit choice wins over the OS preference.
  (function () {
    var saved = null;
    try { saved = window.localStorage.getItem('admin-theme'); } catch (e) { saved = null; }
    if (saved !== 'dark' && saved !== 'light') {
      saved = (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches) ? 'dark' : 'light';
    }
    document.documentElement.setAttribute('data-theme', saved);
  })();
</script>
